<Page x:Class="Pract_15.Pages.MainForm"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:Pract_15.Pages"
          xmlns:infra="clr-namespace:Pract_15.Converters" 
          mc:Ignorable="d"
          Title="Товары"
          xmlns:validators="clr-namespace:Pract_15.Validations"
          DataContext="{Binding RelativeSource={RelativeSource Self}}"
          Loaded="Page_Loaded" Background="{StaticResource MainBackgroundBrush}">

    <Page.Resources>
        <infra:StockToBorderConverter x:Key="StockConverter"/>
    </Page.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Left" x:Name="AdminAccess" Visibility="Collapsed">
            <Button Content="Управление товарами" Click="NavigateToProductsManagement"/>
            <Button Content="Управление категориями"  Click="NavigateToCategoriesManagement"/>
            <Button Content="Управление брендами"  Click="NavigateToBrandsManagement"/>
            <Button Content="Управление тегами" Click="NavigateToTagsManagement"/>
        </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <Label>Поиск</Label>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         TextChanged="SearchTextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <Label>Сортировка</Label>
                <ComboBox SelectionChanged="SortingChanged">
                    <ComboBoxItem Tag="NameAsc">По наименованию </ComboBoxItem>
                    <ComboBoxItem Tag="PriceAsc">По возастанию цены </ComboBoxItem>
                    <ComboBoxItem Tag="PriceDesc">По убывание цене </ComboBoxItem>
                    <ComboBoxItem Tag="StockAsc">По количеству возрастание</ComboBoxItem>
                    <ComboBoxItem Tag="StockDesc">По количеству убывание</ComboBoxItem>
                </ComboBox>

                <Label Margin="10">Фильтры</Label>

                <Label>Категория</Label>
                <ComboBox ItemsSource="{Binding Categories}" 
                          DisplayMemberPath="Name" 
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryId, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="FilterChanged"/>

                <Label>Бренд</Label>
                <ComboBox ItemsSource="{Binding Brands}" 
                          DisplayMemberPath="Name" 
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedBrandId, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="FilterChanged"/>

            <Label>Цена</Label>
            <Label>от</Label>
            <TextBox x:Name="txtPriceFrom" TextChanged="FilterChanged">
                <TextBox.Text>
                    <Binding Path="FilterPriceFrom" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:PriceDataValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtPriceFrom, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="Red" FontSize="10" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label>до</Label>
            <TextBox x:Name="txtPriceTo" TextChanged="FilterChanged">
                <TextBox.Text>
                    <Binding Path="FilterPriceTo" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:PriceDataValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtPriceTo, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="Red" FontSize="10" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ErrorMesssage" Foreground="Red"/>

            <Button Click="ResetFilters_Click" Margin="5">Сбросить</Button>
            </StackPanel>

            <Border Grid.Row="2" Grid.Column="1" Background="LightGray" BorderBrush="Gray" BorderThickness="1">
                <ListView ItemsSource="{Binding ProductsView}"
                          Name="ProductsList" 
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="2" BorderBrush="{Binding Stock, Converter={StaticResource StockConverter}}" BorderThickness="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2">

                                    <TextBlock Text="{Binding Name, TargetNullValue='Название: Неизвестно'}" 
                           FontSize="18" FontWeight="Bold" Margin="5,0,125,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock Text="⭐️" FontSize="14" Foreground="Gold"/>
                                        <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" Margin="5,0" FontSize="14"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Category.Name, TargetNullValue='Категория: Без категории', FallbackValue='Категория: Без категории', StringFormat='Категория: {0}'}" 
                           FontSize="12" Margin="5,0,5,5"/>

                                    <Grid Margin="5,5,5,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Top"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat='Остаток: {0}'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='#{0}'}" FontSize="10" Foreground="#555" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid Grid.Column="1">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Border>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="5">
            <WrapPanel Margin="5">
                <TextBlock Text="{Binding ProductsCount, StringFormat='Всего товаров: {0}'}"/>
                <TextBlock Text="{Binding Items.Count, ElementName=ProductsList, StringFormat=' Показано: {0}'}"/>
            </WrapPanel>
            <Button Content=" выйти " Click="Button_Click"/>
        </StackPanel>
            
        </Grid>
    </Page>