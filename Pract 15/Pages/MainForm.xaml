<Page x:Class="Pract_15.Pages.MainForm"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          xmlns:local="clr-namespace:Pract_15.Pages"
          xmlns:infra="clr-namespace:Pract_15.Converters" 
          mc:Ignorable="d"
          Title="Товары"
          DataContext="{Binding RelativeSource={RelativeSource Self}}"
          Loaded="Page_Loaded" Background="{StaticResource MainBackgroundBrush}">

    <Page.Resources>
        <infra:StockToBorderConverter x:Key="StockConverter"/>
    </Page.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Left" x:Name="AdminAccess" Visibility="Collapsed">
            <Button Content="Управление товарами" Click="NavigateToProductsManagement"/>
            <Button Content="Управление категориями"  Click="NavigateToCategoriesManagement"/>
            <Button Content="Управление брендами"  Click="NavigateToBrandsManagement"/>
            <Button Content="Управление тегами" Click="NavigateToTagsManagement"/>
        </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <Label>Поиск</Label>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         TextChanged="SearchTextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <Label>Сортировка</Label>
                <ComboBox SelectionChanged="SortingChanged">
                    <ComboBoxItem Tag="NameAsc">По наименованию (А-Я)</ComboBoxItem>
                    <ComboBoxItem Tag="PriceAsc">По цене (возрастание)</ComboBoxItem>
                    <ComboBoxItem Tag="PriceDesc">По цене (убывание)</ComboBoxItem>
                    <ComboBoxItem Tag="StockAsc">По количеству (возрастание)</ComboBoxItem>
                    <ComboBoxItem Tag="StockDesc">По количеству (убывание)</ComboBoxItem>
                </ComboBox>

                <Label Margin="0,10,0,0">Фильтры</Label>

                <Label>Категория</Label>
                <ComboBox ItemsSource="{Binding Categories}" 
                          DisplayMemberPath="Name" 
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryId, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="FilterChanged"/>

                <Label>Бренд</Label>
                <ComboBox ItemsSource="{Binding Brands}" 
                          DisplayMemberPath="Name" 
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedBrandId, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="FilterChanged"/>

                <Label>Цена</Label>
                <Label>от</Label>
                <TextBox Text="{Binding FilterPriceFrom, UpdateSourceTrigger=PropertyChanged}" 
                         TextChanged="FilterChanged"/>
                <Label>до</Label>
                <TextBox Text="{Binding FilterPriceTo, UpdateSourceTrigger=PropertyChanged}" 
                         TextChanged="FilterChanged"/>

                <Button Click="ResetFilters_Click" Margin="5">Сбросить</Button>
            </StackPanel>

            <Border Grid.Row="2" Grid.Column="1" Background="LightGray" BorderBrush="Gray" BorderThickness="1">
                <ListView ItemsSource="{Binding ProductsView}" Name="ProductsList" 
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,2"
                BorderBrush="{Binding Stock, Converter={StaticResource StockConverter}}"
                BorderThickness="{Binding Stock, Converter={StaticResource StockConverter}, ConverterParameter=Thickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="✨" FontSize="14"/>
                                        <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" 
                               Margin="5,0,0,0" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Category.Name, StringFormat='Категория: {0}'}" 
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Description}" 
                           TextWrapping="Wrap" Margin="0,2,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1" CornerRadius="5" Margin="0,0,5,5" Padding="5,2">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#555" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Price, StringFormat={}{0:C}}" 
                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Stock, StringFormat='Остаток: {0}'}" 
                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
            </Border>

            <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="5">
                <TextBlock Text="{Binding ProductsCount, StringFormat='Всего товаров: {0}'}"/>
                <TextBlock Text="{Binding Items.Count, ElementName=ProductsList, StringFormat=' Показано: {0}'}"/>
            </WrapPanel>
        </Grid>
    </Page>