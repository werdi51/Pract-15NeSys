<Page x:Class="Pract_15.Pages.MainForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15.Pages"
      mc:Ignorable="d"
      Title="Товары"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Loaded="Page_Loaded">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Label>Поиск</Label>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     TextChanged="SearchTextChanged"/>
        </StackPanel>

        <!-- Левая панель -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <Label>Сортировка</Label>
            <ComboBox SelectionChanged="SortingChanged">
                <ComboBoxItem Tag="NameAsc">По наименованию (А-Я)</ComboBoxItem>
                <ComboBoxItem Tag="PriceAsc">По цене (возрастание)</ComboBoxItem>
                <ComboBoxItem Tag="PriceDesc">По цене (убывание)</ComboBoxItem>
                <ComboBoxItem Tag="StockAsc">По количеству (возрастание)</ComboBoxItem>
                <ComboBoxItem Tag="StockDesc">По количеству (убывание)</ComboBoxItem>
            </ComboBox>

            <Label Margin="0,10,0,0">Фильтры</Label>

            <Label>Категория</Label>
            <ComboBox ItemsSource="{Binding Categories}" 
                      DisplayMemberPath="Name" 
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCategoryId, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="FilterChanged"/>

            <Label>Бренд</Label>
            <ComboBox ItemsSource="{Binding Brands}" 
                      DisplayMemberPath="Name" 
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedBrandId, UpdateSourceTrigger=PropertyChanged}"
                      SelectionChanged="FilterChanged"/>

            <Label>Цена</Label>
            <Label>от</Label>
            <TextBox Text="{Binding FilterPriceFrom, UpdateSourceTrigger=PropertyChanged}" 
                     TextChanged="FilterChanged"/>
            <Label>до</Label>
            <TextBox Text="{Binding FilterPriceTo, UpdateSourceTrigger=PropertyChanged}" 
                     TextChanged="FilterChanged"/>

            <Button Click="ResetFilters_Click" Margin="5">Сбросить</Button>
        </StackPanel>

        <!-- Список товаров -->
        <Border Grid.Row="1" Grid.Column="1" Background="LightGray" BorderBrush="Gray" BorderThickness="1">
            <ListView ItemsSource="{Binding ProductsView}" Name="ProductsList" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <TextBlock>
                                    <Run Text="Категория: "/>
                                    <Run Text="{Binding Category.Name}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Бренд: "/>
                                    <Run Text="{Binding Brand.Name}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock>
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding Price, StringFormat={}{0:C}}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Остаток: "/>
                                    <Run Text="{Binding Stock}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="5">
            <TextBlock Text="{Binding ProductsCount, StringFormat='Всего товаров: {0}'}"/>
            <TextBlock Text="{Binding Items.Count, ElementName=ProductsList, StringFormat=' Показано: {0}'}"/>
        </WrapPanel>
    </Grid>
</Page>