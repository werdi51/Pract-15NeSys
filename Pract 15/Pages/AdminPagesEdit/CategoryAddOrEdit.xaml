<Page x:Class="Pract_15.Pages.AdminPagesEdit.CategoryAddOrEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15.Pages.AdminPagesEdit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавление категории"
      xmlns:validators="clr-namespace:Pract_15.Validations"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Background="{StaticResource MainBackgroundBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="error">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Label FontSize="30" HorizontalAlignment="Center">Введите категорию</Label>
            <TextBox Name="txtName" Margin="10" FontSize="20">
                <TextBox.Text>
                    <Binding Path="CategoryName" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:NameEmptyDataValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <ItemsControl ItemsSource="{Binding ElementName=txtName, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" 
                                   Text="{Binding ErrorContent}" 
                                   HorizontalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="Ok_Click" Width="70" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="70" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>