<Page x:Class="Pract_15.Pages.AdminPagesEdit.ProductAddOrEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15.Pages.AdminPagesEdit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
           Title="Товар"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Loaded="Page_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Название:"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtName" Margin="5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Описание:"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="txtDescription" TextWrapping="Wrap" Height="60" Margin="5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Цена:"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="txtPrice" Margin="5"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Остаток:"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="txtStock" Margin="5"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Рейтинг:"/>
        <TextBox Grid.Row="4" Grid.Column="1" Name="txtRating" Margin="5"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Категория:"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Name="cmbCategory" 
                  DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Бренд:"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Name="cmbBrand" 
                  DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="Save_Click" Width="80" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
