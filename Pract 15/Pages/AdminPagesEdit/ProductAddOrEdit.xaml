<Page x:Class="Pract_15.Pages.AdminPagesEdit.ProductAddOrEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15.Pages.AdminPagesEdit"
      xmlns:validators="clr-namespace:Pract_15.Validations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Товар"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Loaded="Page_Loaded"
      Background="{StaticResource MainBackgroundBrush}">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="error">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Название:"/>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBox Name="txtName" Margin="5">
                <TextBox.Text>
                    <Binding Path="ProductName" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:NameEmptyDataValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtName, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Label Grid.Row="1" Grid.Column="0" Content="Описание:"/>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBox Name="txtDescription" TextWrapping="Wrap" Height="60" Margin="5">
                <TextBox.Text>
                    <Binding Path="Description" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:DescriptionEmptyDataValidations/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtDescription, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Label Grid.Row="2" Grid.Column="0" Content="Цена:"/>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <TextBox Name="txtPrice" Margin="5">
                <TextBox.Text>
                    <Binding Path="Price" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:PriceDataValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtPrice, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Label Grid.Row="3" Grid.Column="0" Content="Остаток:"/>
        <StackPanel Grid.Row="3" Grid.Column="1">
            <TextBox Name="txtStock" Margin="5">
                <TextBox.Text>
                    <Binding Path="Stock" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:StockDataValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtStock, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Label Grid.Row="4" Grid.Column="0" Content="Категория:"/>
        <StackPanel Grid.Row="4" Grid.Column="1">
            <ComboBox Name="cmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5">
                <ComboBox.SelectedValue>
                    <Binding Path="CategoryId" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:ComboBoxValidation/>
                        </Binding.ValidationRules>
                    </Binding>
                </ComboBox.SelectedValue>
            </ComboBox>
            <ItemsControl ItemsSource="{Binding ElementName=cmbCategory, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Label Grid.Row="5" Grid.Column="0" Content="Рейтинг:"/>
        <StackPanel Grid.Row="5" Grid.Column="1">
            <TextBox Name="txtRating" Margin="5" >
                            <TextBox.Text>
                    <Binding Path="Rating" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:RatingDataValidations/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl ItemsSource="{Binding ElementName=txtRating, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource error}" Text="{Binding ErrorContent}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Label Grid.Row="6" Grid.Column="0" Content="Бренд:"/>
        <StackPanel Grid.Row="6" Grid.Column="1">
            <ComboBox Name="cmbBrand" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5" 
                  SelectedValue="{Binding BrandId, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" Width="100" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>