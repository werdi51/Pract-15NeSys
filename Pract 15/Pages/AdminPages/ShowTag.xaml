<Page x:Class="Pract_15.Pages.AdminPages.ShowTag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_15.Pages.AdminPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление тегами"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Click="Back_Click">Назад</Button>
            <Button Click="Add_Click">Добавить</Button>
            <Button Click="Delete_Click">Удалить</Button>
        </StackPanel>

        <ListView Grid.Row="1" 
                  ItemsSource="{Binding Tags}"
                  SelectedItem="{Binding SelectedTag}"
                  MouseDoubleClick="Edit_DoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="5"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
