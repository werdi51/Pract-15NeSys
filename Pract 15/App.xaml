<Application x:Class="Pract_15.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pract_15"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00fa9a"/>
        <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#000"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#7FFF00"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#fff"/>
    </Application.Resources>
</Application>