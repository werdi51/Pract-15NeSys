<Window x:Class="Pract15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pract15"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Activated="LoadList"
        
        mc:Ignorable="d"
        Title="Данные формы" Height="450" Width="800">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="AutomationProperties.Name" Value="" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="AutomationProperties.Name" Value="" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Label>Поиск</Label>
            <TextBox Text="{Binding searchQuerry, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" materialDesign:HintAssist.Hint="Введите текст для поиска"/>
        </StackPanel>

        <!-- Левая панель (сортировка и фильтры) -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <Label FontSize="16">Сортировка</Label>
            <ComboBox SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.Items>
                    <ComboBoxItem Tag="Age">По возрасту</ComboBoxItem>
                    <ComboBoxItem Tag="Weight">По весу</ComboBoxItem>
                    <ComboBoxItem Tag="Heigth">По росту</ComboBoxItem>
                </ComboBox.Items>
            </ComboBox>

            <Label>Фильтры</Label>
            <StackPanel>
                <Label FontSize="16">Фильтр по росту</Label>
                <Label>от</Label>
                <TextBox Text="{Binding filterHeightFrom,UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите рост" TextChanged="TextBox_TextChanged"/>
                <Label>до</Label>
                <TextBox Text="{Binding filterHeightTo,UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Введите рост" TextChanged="TextBox_TextChanged"/>
            </StackPanel>

            <Button Margin="5">Сбросить</Button>
        </StackPanel>

        <!-- Правая панель с ColorZone и списком -->
        <materialDesign:ColorZone Grid.Row="1" Grid.Column="1" Mode="SecondaryMid">
            <ListView ItemsSource="{Binding forms}" Name="FormsList" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding LastName}"/>
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock>
                                    <Run Text="Возраст "/>
                                    <Run Text="{Binding Age}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Год рождения "/>
                                    <Run Text="{Binding BirthdayYear}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="Рост "/>
                                    <Run Text="{Binding Height}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right">
                                    <Run Text="Вес "/>
                                    <Run Text="{Binding Weight, StringFormat={}{0:F2}}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </materialDesign:ColorZone>

        <!-- Нижняя панель (например, для статуса) -->
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding forms.Count, StringFormat='{}Всего запией:{0}'}"/>
            <TextBlock Text="{Binding Items.Count, ElementName=FormsList,StringFormat='{} Показано: {0}'}"/>
        </WrapPanel>
    </Grid>
</Window>
